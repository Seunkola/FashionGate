generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model Role {
  @@schema("public")
  @@map("roles")

  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?

  users       User[]
}

model UserLocation {
  @@schema("public")
  @@map("user_locations")

  id               String        @id @default(uuid()) @db.Uuid
  address          String
  local_government String        
  city             String        
  state            String        
  country          String        
  user_id          String @unique @db.Uuid       
  users            User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model User {
  @@schema("public")
  @@map("users")

  id                String          @id @db.Uuid
  email             String          @unique 
  first_name        String?         
  last_name         String?         
  role_id           String         @db.Uuid
  profile_image_url String?
  created_at        DateTime?       @default(now())
  user_locations    UserLocation?
  role              Role          @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}
