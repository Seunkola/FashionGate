  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@supabase/supabase-js": "^2.0.0",
    "amqplib": "^0.10.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.0",
    "prisma": "^6.16.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
