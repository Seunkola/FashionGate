generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

//
// ==============================
// ENUMS
// ==============================
//

enum BookingStatus {
@@schema("public")
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
@@schema("public")
  unpaid
  paid
}

enum NotificationType {
@@schema("public")
  email
  app
}

//
// ==============================
// USERS & AUTH
// ==============================
//

model Role {
  @@schema("public")
  @@map("roles")

  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?

  users User[]
}

model User {
  @@schema("public")
  @@map("users")

  id                String          @id @db.Uuid
  email             String          @unique @db.VarChar(255)
  first_name        String?         @db.VarChar(150)
  last_name         String?         @db.VarChar(150)
  role_id           String?         @db.Uuid
  profile_image_url String?
  created_at        DateTime?       @default(now()) @db.Timestamp(6)

  role          Role?          @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location      UserLocation?
  portfolios    Portfolio[]
  services      Service[]
  bookings      Booking[]
  reviews       Review[]
  ratings       Rating[]
  notifications Notification[]
}

model UserLocation {
  @@schema("public")
  @@map("user_locations")

  id               String @id @default(uuid()) @db.Uuid
  address          String
  local_government String @db.VarChar(255)
  city             String @db.VarChar(255)
  state            String @db.VarChar(255)
  country          String @db.VarChar(255)
  user_id          String @unique @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

//
// ==============================
// PORTFOLIO
// ==============================
//

model Portfolio {
  @@schema("public")
  @@map("portfolios")

  id          String           @id @default(uuid()) @db.Uuid
  designer_id String?          @db.Uuid
  title       String?          @db.VarChar(255)
  description String?
  created_at  DateTime?        @default(now()) @db.Timestamp(6)

  designer User?             @relation(fields: [designer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  images   PortfolioImage[]
  skills   PortfolioSkill[]
  ratings  Rating[]
}

model PortfolioImage {
  @@schema("public")
  @@map("portfolio_images")

  id           String     @id @default(uuid()) @db.Uuid
  portfolio_id String?    @db.Uuid
  image_url    String
  created_at   DateTime?  @default(now()) @db.Timestamp(6)

  portfolio Portfolio? @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Skill {
  @@schema("public")
  @@map("skills")

  id     String           @id @default(uuid()) @db.Uuid
  name   String           @unique @db.VarChar(100)
  skills PortfolioSkill[]
}

model PortfolioSkill {
  @@schema("public")
  @@map("portfolio_skills")

  portfolio_id String    @db.Uuid
  skill_id     String    @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill     Skill     @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([portfolio_id, skill_id])
  @@index([skill_id], map: "idx_portfolio_skills")
}

model Rating {
  @@schema("public")
  @@map("ratings")

  id           String    @id @default(uuid()) @db.Uuid
  rating       Int
  customer_id  String?   @db.Uuid
  portfolio_id String?   @db.Uuid

  customer  User?      @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  portfolio Portfolio? @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([portfolio_id], map: "idx_portfolio_ratings")
}

//
// ==============================
// SERVICES & BOOKINGS
// ==============================
//

model Service {
  @@schema("public")
  @@map("services")

  id            String     @id @default(uuid()) @db.Uuid
  designer_id   String?    @db.Uuid
  name          String     @db.VarChar(150)
  description   String?
  price         Decimal    @db.Decimal(10, 2)
  duration_days Int
  availability   Boolean    @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)

  designer User?     @relation(fields: [designer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings Booking[]

  @@index([designer_id], map: "idx_services_designer")
}

model Booking {
  @@schema("public")
  @@map("bookings")

  id             String        @id @default(uuid()) @db.Uuid
  client_id      String?       @db.Uuid
  service_id     String?       @db.Uuid
  start_date     DateTime      @db.Timestamp(6)
  end_date       DateTime      @db.Timestamp(6)
  booking_status BookingStatus @default(pending)
  payment_status PaymentStatus @default(unpaid)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)

  client  User?    @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service Service? @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews Review[]

  @@index([client_id], map: "idx_bookings_client")
  @@index([service_id], map: "idx_bookings_service")
}

//
// ==============================
// REVIEWS
// ==============================
//

model Review {
  @@schema("public")
  @@map("reviews")

  id          String    @id @default(uuid()) @db.Uuid
  booking_id  String?   @db.Uuid
  customer_id String?   @db.Uuid
  review      String
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  booking  Booking? @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer User?    @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

//
// ==============================
// NOTIFICATIONS
// ==============================
//

model Notification {
  @@schema("public")
  @@map("notifications")

  id        String            @id @default(uuid()) @db.Uuid
  user_id   String?           @db.Uuid
  message   String
  type      NotificationType?
  is_read   Boolean           @default(false)
  created_at DateTime?        @default(now()) @db.Timestamp(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
